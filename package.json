{
  "name": "csv-verkstan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Webbaserat CSV-verktyg som kör helt lokalt i webbläsaren",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@preact/signals": "^2.4.0",
    "fflate": "^0.8.3",
    "papaparse": "^5.5.3",
    "preact": "^10.27.2",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/papaparse": "^5.3.16",
    "fast-check": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
